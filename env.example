# Environment Configuration Example
# Copy this file to `.env` and fill in your own keys.

# ============================================
# OpenAI API Configuration
# ============================================
OPENAI_API_KEY=sk-example-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-nano

# GPT-5 Parameters
OPENAI_VERBOSITY=medium
OPENAI_REASONING_EFFORT=medium
OPENAI_ALLOWED_TOOLS=web,python
OPENAI_GRAMMAR_ENABLED=false

# ============================================
# Proxy Configuration
# ============================================
PROXY_ENABLED=false
PROXY_HOST=proxy.example.com
PROXY_PORT=8080
PROXY_USERNAME=example_user
PROXY_PASSWORD=example_password
PROXY_TYPE=http

# ============================================
# Yandex API Configuration
# ============================================
YANDEX_WORDSTAT_TOKEN=y0__example_token
YANDEX_CLOUD_API_KEY=example_yandex_cloud_api_key
YANDEX_CLIENT_ID=example_yandex_client_id
YANDEX_CLIENT_SECRET=example_yandex_client_secret

# Legacy Yandex API (optional)
YANDEX_TOKEN=
YANDEX_USERNAME=

# ============================================
# GTmetrix API Configuration
# ============================================
GTMETRIX_API_KEY=example_gtmetrix_api_key

# ============================================
# Bright Data MCP Configuration
# ============================================
BRIGHTDATA_API_TOKEN=example_brightdata_token
BRIGHTDATA_MCP_BASE_URL=https://mcp.brightdata.com/mcp
BRIGHTDATA_MCP_TIMEOUT=60

# ============================================
# Service Ports (internal defaults; usually you do not need to change them)
# ============================================
SEO_SERVICE_PORT=8001
TEXT_SERVICE_PORT=8002
CONVENIENCE_SERVICE_PORT=8003
SENIOR_SERVICE_PORT=8004

# ============================================
# Application Settings
# ============================================
REQUEST_TIMEOUT=600
MAX_RETRIES=3
SCREENSHOT_WIDTH=1920
SCREENSHOT_HEIGHT=1080
